# Postgres connection for the standalone `healthyfutures` database.
DATABASE_URL=postgres://healthyfutures:CHANGE_ME@localhost:5432/healthyfutures

# Required. Must be 32+ chars and not a known default, or startup fails in
# production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

PORT=3000

# Set to "production" on a deployed instance to enforce config checks.
NODE_ENV=development

# Comma-separated allowed origins. Leave blank to allow all (development only).
CORS_ORIGINS=

# Optional. Without a key the assistant falls back to built-in keyword logic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
