{
  "expo": {
    "name": "Healthy Futures",
    "slug": "healthy-futures",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#123626"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tachyonleap.healthyfutures",
      "infoPlist": {
        "NSCameraUsageDescription": "Healthy Futures uses your camera to record practice clips to send to your coach.",
        "NSMicrophoneUsageDescription": "Healthy Futures uses your microphone to record audio with your practice clips.",
        "NSPhotoLibraryUsageDescription": "Healthy Futures needs access to your library to choose a practice video to send.",
        "NSSpeechRecognitionUsageDescription": "Healthy Futures turns your speech into text so you can talk to your AI assistant instead of typing.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#123626"
      },
      "package": "com.tachyonleap.healthyfutures",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Healthy Futures needs access to your library to choose a practice video to send.",
          "cameraPermission": "Healthy Futures uses your camera to record practice clips to send to your coach.",
          "microphonePermission": "Healthy Futures uses your microphone to record audio with your practice clips."
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-video",
      "expo-audio",
      "expo-notifications",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "2e50cfc2-3a16-4999-b32f-563441cd4de3"
      }
    },
    "owner": "devanshm17s-team"
  }
}
